#!/bin/bash
# Configuration variables for Gemini Enterprise License Distribution scripts
#
# INSTRUCTIONS:
# Copy this file to 'env.sh' (if not already copied) and replace the placeholders 
# with your actual Google Cloud resources details.

# 1. Billing Account & Subscription Configuration
# ID of your Google Cloud billing account.
export BILLING_ACCOUNT_ID="YOUR_BILLING_ACCOUNT_ID"

# Locate the Billing Account License Config ID (e.g., in subscription details)
export BILLING_ACCOUNT_LICENSE_CONFIG_ID="YOUR_BILLING_ACCOUNT_LICENSE_CONFIG_ID"

# 2. Location Configuration
# The multi-region for your API requests. Specify one of: "us", "eu", or "global"
export ENDPOINT_LOCATION="global"

# The multi-region of your data store/license configs: "global", "us", or "eu"
export LOCATION="global"

# 3. Project Configuration
# The project number of a project where you have the "Service Usage Consumer" role.
# This project is billed/throttled for the API requests (X-Goog-User-Project header).
export USER_PROJECT_NUMBER="YOUR_USER_PROJECT_NUMBER"

# 4. Target Project Configuration (For distributing / reclaiming licenses)
# The target project ID and project number where licenses will be distributed and users assigned.
export TARGET_PROJECT_ID="YOUR_TARGET_PROJECT_ID"
export TARGET_PROJECT_NUMBER="YOUR_TARGET_PROJECT_NUMBER"
