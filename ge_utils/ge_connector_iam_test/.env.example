# Copy this file to .env and set the values. Do not commit .env.

# Google Cloud project that holds classic Gemini Enterprise.
PROJECT_ID=your-project-id
PROJECT_NUMBER=123456789012

# Gemini Enterprise location (global, us, or eu). The test used global.
LOCATION=global

# Cloud Run and Cloud Storage region.
REGION=us-central1

# The end user for the test. This user must not hold Owner, Editor, or any
# predefined Discovery Engine role at project level.
TEST_USER=test-user@example.com

# Resource IDs that the scripts create.
APP_ID=iamtest-app
MCP_COLLECTION_ID=iamtest-mcp-a
DOCS_DATASTORE_ID=iamtest-docs-b
BUCKET=your-project-id-iamtest-docs-b
MCP_SERVICE=iamtest-mcp-a

# Optional. The MCP server URL. If empty, 30_create_mcp_connector.sh reads it
# from the Cloud Run service.
MCP_URL=

# Optional. The admin account for gcloud (passed as --account). If empty, the
# scripts use the active gcloud account.
ADMIN_ACCOUNT=
