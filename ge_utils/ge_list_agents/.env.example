# -----------------------------------------------------------------------------
# Google Cloud Project Configuration
# -----------------------------------------------------------------------------
# Optional: Set the default GCP project ID. If not set, the scripts will attempt 
# to automatically detect it from active gcloud config or metadata service.
PROJECT_ID=your-gcp-project-id


# Optional: Comma-separated list of Google Cloud locations to scan.
# If not set, the listing scripts scan "global", "us" and "eu".
# Write a comment on its own line. Do not write it after the value.
# Examples: global
#           global,us
LOCATION=global



# -----------------------------------------------------------------------------
# Microsoft Entra ID (Azure AD) Client Credentials (for resolve_entra_users.py)
# -----------------------------------------------------------------------------
# Required by resolve_entra_users.py to obtain an access token for Graph API.
# You can find these in the Azure Portal -> Microsoft Entra ID -> App registrations.
AZURE_TENANT_ID=your-tenant-id-guid
AZURE_CLIENT_ID=your-client-id-guid
AZURE_CLIENT_SECRET=your-client-secret-string
