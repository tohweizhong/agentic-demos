# Gemini Enterprise Prober Configuration
# Copy this file to .env for local testing

GCP_PROJECT_ID=YOUR_GCP_PROJECT_ID
GE_LOCATION=global
GE_ENGINE_ID=YOUR_GEMINI_ENTERPRISE_ENGINE_ID
GE_ASSISTANT_ID=default_assistant
GE_DATA_STORE_IDS=datastore_1,datastore_2
GE_MAX_CONCURRENCY=4
GE_TIMEOUT_SECONDS=180

# Optional: Override GCP token directly (otherwise automatically uses ADC/WIF)
# GCP_ACCESS_TOKEN=ya29...
