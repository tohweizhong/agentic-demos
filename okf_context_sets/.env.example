# Copy this file to .env and replace the placeholders.
# Do not commit .env.

# Google Cloud project that holds the context set and the BigQuery dataset.
PROJECT_ID=your-project-id

# Knowledge Catalog location for the entry group (context set).
REGION=us-central1

# Entry group ID for the context set. kcmd creates it on the first push.
ENTRY_GROUP=okf-demo-catalog

# BigQuery dataset for the optional seed data.
BQ_DATASET=okf_demo

# BigQuery dataset location. Use a multi-region (US, EU) or a region.
BQ_LOCATION=US

# kcmd release from npm (@google-cloud/kcmd).
KCMD_VERSION=0.2.5
