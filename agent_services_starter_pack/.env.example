# Copy this file to .env and set the values. .env is gitignored.
# Placeholders only. Do not commit real values.

# Required.
PROJECT_ID=your-project-id
# A new bucket name for the deploy files. bootstrap.sh creates it.
STAGING_BUCKET=your-project-id-agent-staging

# Optional. The values below are the defaults.
REGION=asia-southeast1
MODEL=gemini-3.5-flash
MEMORY_GENERATION_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=text-embedding-005
# The location in the embedding model resource name. Empty means REGION.
EMBEDDING_LOCATION=
AGENT_DISPLAY_NAME=svcpack-agent
# true logs prompts, responses, and user IDs in the traces. Get user consent first.
CAPTURE_MESSAGE_CONTENT=false

# deploy.py writes this value. Do not set it yourself.
AGENT_RUNTIME_NAME=
