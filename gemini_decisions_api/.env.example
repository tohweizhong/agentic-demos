# Copy this file to .env and set the values for one backend.

# --- Backend 1: Gemini Developer API (default) ---
# Get a key from Google AI Studio.
GEMINI_API_KEY=your-api-key

# --- Backend 2: Vertex AI (early access only) ---
# Remove the comment marks to use Vertex AI. Then run:
#   gcloud auth application-default login
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# --- Optional model overrides ---
# DECISIONS_MODEL=gemini-decision-1
# MODEL_TIER_LITE=
# MODEL_TIER_FLASH=
# MODEL_TIER_PRO=
