# Copy this file to .env and replace each placeholder.
# Never commit .env. The repository .gitignore excludes it.

# Google Cloud project.
PROJECT_ID=YOUR_PROJECT_ID
PROJECT_NUMBER=YOUR_PROJECT_NUMBER
ORG_ID=YOUR_ORG_ID
# One region for the agent, the auth provider, and Cloud Run.
# Auth providers are regional. The agent region must match.
REGION=us-central1

# Auth Manager auth provider for GitHub (3LO).
AUTH_PROVIDER_ID=YOUR_AUTH_PROVIDER_ID
# Set to true only if 01_auth_provider.sh created the provider for this demo.
# cleanup.sh deletes the provider only when this value is true.
AUTH_PROVIDER_OWNED_BY_DEMO=false
# Optional. 01_auth_provider.sh sets these on the provider when both are set.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional. The GitHub OAuth app settings page for the demo controls panel.
# Example: https://github.com/settings/applications/YOUR_APP_NUMBER
GITHUB_APP_URL=https://github.com/settings/developers

# Agent on Agent Runtime.
AGENT_DISPLAY_NAME=agent-auth-3lo-github
# 02_deploy_agent.sh writes the new ID here.
AGENT_ID=
# Optional. Agent Runtime engine IDs for the Ingress and Egress gateway tabs.
INGRESS_AGENT_ID=YOUR_INGRESS_ENGINE_ID
EGRESS_AGENT_ID=YOUR_EGRESS_ENGINE_ID
MODEL_ID=gemini-3.8-flash
MODEL_LOCATION=global

# Sample UI client on Cloud Run, protected by IAP.
CLIENT_SERVICE=agent-auth-client
CLIENT_SA_NAME=agent-auth-client
# Service account that Cloud Build uses to build the client image.
BUILD_SA_NAME=agent-auth-build
# The person who can open the client through IAP.
# Options for the Project ID and Location dropdowns in the client.
# Comma-separated lists. If a list is empty, the client shows the default only.
PROJECT_OPTIONS=YOUR_PROJECT_ID
LOCATION_OPTIONS=us-central1
IAP_MEMBER=user:YOUR_EMAIL_ADDRESS
