# Copy this file to terraform.tfvars and put the real values there.
# terraform.tfvars is gitignored. Never commit real IDs.

project_id      = "PROJECT_ID"
project_number  = "PROJECT_NUMBER"
organization_id = "ORG_ID"
region          = "us-central1"

# Governance tiers (Tier 1 is always on):
# Tier 2: Agent Registry catalog entries
# Tier 3: Egress Agent Gateway + IAP Policy V2
# Tier 4: Model Armor content safety (only Tier 4 needs domain restriction setup)
# Tier 5: Ingress Agent Gateway (Client-to-Agent)
enable_agent_registry  = true
enable_egress_gateway  = true
enable_model_armor     = true
enable_ingress_gateway = false

# Start in DRY_RUN. Change to ENFORCE after the checks in DRY_RUN pass.
iap_enforcement_mode = "DRY_RUN"

# Set to true only if the organization uses domain restricted sharing and the
# organization admin approves the project-level exception.
allow_google_managed_members = false
