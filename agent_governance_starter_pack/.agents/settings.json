{
  "allowNonWorkspaceAccess": false,
  "permissions": {
    "allow": [
      "command(scripts/preflight.sh)",
      "command(scripts/package_agent.sh)",
      "command(scripts/ask_agent.sh)",
      "command(scripts/read_audit_log.sh)",
      "command(terraform fmt)",
      "command(terraform validate)",
      "command(terraform test)",
      "command(terraform plan)",
      "command(terraform output)",
      "command(terraform -chdir=terraform output)",
      "command(terraform -chdir=terraform state list)",
      "command(gcloud config get-value)",
      "command(gcloud projects describe)",
      "command(gcloud projects get-ancestors)",
      "command(gcloud projects get-iam-policy)",
      "command(gcloud services list)",
      "command(gcloud org-policies describe)",
      "command(gcloud logging read)",
      "command(go test)",
      "command(go vet)"
    ],
    "ask": [
      "command(regex:.*\\bterraform\\b.*\\bapply\\b.*)",
      "command(regex:.*\\bterraform\\b.*\\bdestroy\\b.*)",
      "command(regex:.*\\bcleanup\\.sh\\b.*)"
    ],
    "deny": [
      "command(regex:.*\\bgcloud\\s+organizations\\b.*)",
      "command(regex:.*\\bgcloud\\s+org-policies\\s+(set-policy|delete)\\b.*)",
      "command(regex:.*\\|\\s*(\\S*/)?cleanup\\.sh\\b.*)",
      "command(regex:.*\\byes\\b.*\\|.*)"
    ]
  }
}
