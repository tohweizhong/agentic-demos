{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/preflight.sh*)",
      "Bash(scripts/package_agent.sh)",
      "Bash(scripts/ask_agent.sh*)",
      "Bash(scripts/read_audit_log.sh*)",
      "Bash(terraform fmt*)",
      "Bash(terraform validate*)",
      "Bash(terraform test*)",
      "Bash(terraform plan*)",
      "Bash(terraform output*)",
      "Bash(gcloud projects describe*)",
      "Bash(gcloud projects get-iam-policy*)",
      "Bash(gcloud services list*)",
      "Bash(gcloud org-policies describe*)",
      "Bash(gcloud logging read*)",
      "Bash(go test*)",
      "Bash(go vet*)"
    ],
    "ask": [
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(scripts/cleanup.sh*)"
    ],
    "deny": [
      "Bash(gcloud organizations*)",
      "Bash(gcloud org-policies set-policy*)",
      "Bash(gcloud org-policies delete*)"
    ]
  }
}
